{
  "name": "rxjs-execution-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "See what an RxJS execution did, when it happened, and why.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "node scripts/generate-examples.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
